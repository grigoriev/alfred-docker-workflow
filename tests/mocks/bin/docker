#!/bin/bash
# Mock docker for tests. Logs argv to $DOCKER_LOG. DOCKER_DOWN=1 fails ps/info
# to simulate a stopped daemon. DOCKER_PS_FIXTURE overrides the container set.
echo "$@" >> "${DOCKER_LOG:-/dev/null}"
case "$1" in
  ps)
    [[ "$DOCKER_DOWN" == "1" ]] && exit 1
    if [[ -n "$DOCKER_PS_FIXTURE" && -f "$DOCKER_PS_FIXTURE" ]]; then
      cat "$DOCKER_PS_FIXTURE"
    else
      cat <<'JSON'
{"ID":"aaaa111","Names":"web","Image":"nginx:latest","State":"running","Status":"Up 3 minutes","Ports":"0.0.0.0:8080->80/tcp, :::8080->80/tcp"}
{"ID":"bbbb222","Names":"db","Image":"postgres:16","State":"exited","Status":"Exited (0) 2 hours ago","Ports":""}
JSON
    fi
    ;;
  images)
    [[ "$DOCKER_DOWN" == "1" ]] && exit 1
    if [[ -n "$DOCKER_IMAGES_FIXTURE" && -f "$DOCKER_IMAGES_FIXTURE" ]]; then
      cat "$DOCKER_IMAGES_FIXTURE"
    else
      cat <<'JSON'
{"ID":"img111","Repository":"nginx","Tag":"latest","Size":"142MB","CreatedSince":"2 weeks ago"}
{"ID":"img222","Repository":"postgres","Tag":"16","Size":"430MB","CreatedSince":"3 days ago"}
{"ID":"img333","Repository":"<none>","Tag":"<none>","Size":"88MB","CreatedSince":"5 minutes ago"}
JSON
    fi
    ;;
  inspect) echo '[{"Id":"aaaa111","State":{"Status":"running"}}]' ;;
  info) [[ "$DOCKER_DOWN" == "1" ]] && exit 1; echo "ok" ;;
  *) : ;;
esac
exit 0
